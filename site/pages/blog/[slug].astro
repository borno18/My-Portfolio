---
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import EditorialMedia from '../../components/EditorialMedia.astro';
import { editorialDetails } from '../../lib/editorial.js';
import { getPosts, renderMarkdown } from '../../lib/content.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.slug }, props: { post, related: posts.filter(item => item.slug !== post.slug).slice(0, 2) } }));
}
const { post, related } = Astro.props;
const detail = editorialDetails(post);
const schema = post.published_at ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description, datePublished: post.published_at, url: new URL('/blog/' + post.slug, Astro.site).href, author: { '@type': 'Person', name: 'Joydip Majumdar', url: Astro.site.href } } : undefined;
---
<Base title={post.title} description={post.description} schema={schema}>
  <article class="feature-article">
    <header class="reading article-header">
      <Link class="article-section-link" href="/blog">Blog</Link>
      <h1>{post.title}</h1>
      <p class="article-deck">{post.description}</p>
      <div class="article-byline">
        {post.published_at ? <span>By Joydip Majumdar</span> : <span>{detail.category}</span>}
        {detail.date && <time datetime={post.published_at}>{detail.date}</time>}
        <span>{detail.minutes}</span>
      </div>
    </header>
    {detail.cover && <figure class="wrap article-cover"><EditorialMedia cover={detail.cover} large /></figure>}
    <div class="reading article article-prose" set:html={renderMarkdown(post.body)} />
  </article>
  <aside class="reading related-articles" aria-labelledby="read-next">
    <h2 id="read-next">Read next</h2>
    {related.map(item => <Link href={'/blog/' + item.slug}>{item.title}</Link>)}
  </aside>
</Base>
