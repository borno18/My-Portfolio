---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import EditorialMedia from '../../components/EditorialMedia.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import { editorialDetails } from '../../lib/editorial.js';
import { getPost, getPosts, renderMarkdown } from '../../lib/content.js';

Astro.response.headers.set('Cache-Control', 'no-store');
const { slug } = Astro.params;
if (!slug || slug.length > 100 || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
  return Astro.rewrite('/404');
}
const [post, related] = await Promise.all([
  getPost(slug),
  getPosts({ excludeSlug: slug, limit: 2, columns: 'slug,title' }).catch(error => {
    console.error(error);
    return [];
  }),
]);
if (!post) {
  return Astro.rewrite('/404');
}
const detail = editorialDetails(post);
const articleUrl = new URL('/blog/' + post.slug, Astro.site).href;
const schema = post.published_at ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description, datePublished: post.published_at, url: articleUrl, author: { '@type': 'Person', name: 'Joydip Majumdar', url: Astro.site.href } } : undefined;
---
<Base title={post.title} description={post.description} schema={schema} socialImage={detail.photo?.src}>
  <article class="feature-article">
    <header class="reading article-header">
      <Link class="article-section-link" href="/blog">Blog</Link>
      <h1>{post.title}</h1>
      <p class="article-deck">{post.description}</p>
      <div class="article-byline">
        {post.published_at ? <span>By Joydip Majumdar</span> : <span>{detail.category}</span>}
        {detail.date && <time datetime={post.published_at}>{detail.date}</time>}
        <span>{detail.minutes}</span>
      </div>
      <ArticleShare title={post.title} url={articleUrl} />
    </header>
    {(detail.cover || detail.photo) && <figure class="wrap article-cover"><EditorialMedia cover={detail.cover} photo={detail.photo} large /></figure>}
    <div class="reading article article-prose" set:html={renderMarkdown(post.body, Astro.site, Astro.url)} />
  </article>
  {related.length > 0 && <aside class="reading related-articles" aria-labelledby="read-next">
    <h2 id="read-next">Read next</h2>
    {related.map(item => <Link href={'/blog/' + item.slug}>{item.title}</Link>)}
  </aside>}
</Base>
