---
export const prerender = false;
import { createHmac } from 'node:crypto';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import { env, publicDatabase } from '../lib/content.js';
import { sameOrigin, field, InputError } from '../lib/server.js';
import { emailAddress, topics } from '../lib/contact.js';

Astro.response.headers.set('Cache-Control', 'no-store');
const db = publicDatabase();
const key = env('CONTACT_INBOX_KEY') || '';
const ready = Boolean(db && /^[a-f0-9]{64}$/.test(key));
const sent = ready && Astro.url.searchParams.get('sent') === 'yes';
let notice = '';
let values = {};
if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Forbidden', { status: 403 });
  if (Number(Astro.request.headers.get('content-length')) > 20000) return new Response('Message is too large', { status: 413 });
  try {
    const form = await Astro.request.formData();
    if (form.get('website')) return Astro.redirect('/contact?sent=yes', 303);
    const submitted = (name, max) => typeof form.get(name) === 'string' ? String(form.get(name)).slice(0, max) : '';
    values = { name: submitted('name', 100), email: submitted('email', 254), topic: submitted('topic', 40), message: submitted('message', 2800) };
    const name = field(form, 'name', 100);
    const email = field(form, 'email', 254).toLowerCase();
    const topic = field(form, 'topic', 40);
    const message = field(form, 'message', 2800);
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new InputError('Enter a valid email address.');
    if (!topics.includes(topic)) throw new InputError('Choose a topic for your message.');
    if (!ready) throw new Error('Contact inbox is unavailable');
    const ip = Astro.request.headers.get('x-vercel-forwarded-for')?.split(',')[0]?.trim() || 'unknown';
    const fingerprint = createHmac('sha256', key).update('contact-ip:' + ip).digest('hex');
    const { data, error } = await db.rpc('portfolio_receive_message', {
      delivery_key: key, sender_fingerprint: fingerprint, sender_name: name, sender_email: email, sender_message: 'Topic: ' + topic + '\n\n' + message,
    });
    if (error) throw error;
    if (data === 'received') return Astro.redirect('/contact?sent=yes', 303);
    if (data !== 'limited') throw new Error('Unexpected contact result');
    Astro.response.status = 429;
    notice = 'Too many messages. Try again later or email me directly.';
  } catch (error) {
    Astro.response.status = error instanceof InputError ? 400 : 502;
    if (!(error instanceof InputError)) console.error('Contact delivery failed', { code: error?.code });
    notice = error instanceof InputError ? error.message : 'I couldn’t confirm delivery. Try again or email me directly.';
  }
}
---
<Base title="Contact" description="Contact Joydip Majumdar about software engineering projects, opportunities, or photography.">
  <section class="wrap page-intro contact-layout">
    <div class="contact-intro">
      <h1>Contact</h1>
      <p>Get in touch about software projects, roles, or photography.</p>
      <div class="contact-method">
        <span class="meta">Email</span>
        <Link href={'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(emailAddress)}>{emailAddress}</Link>
        <button type="button" class="copy-button" data-copy-email={emailAddress} hidden>Copy address</button>
        <span role="status" data-copy-status></span>
      </div>
      <div class="contact-method"><span class="meta">LinkedIn</span><Link href="https://www.linkedin.com/in/joydip-majumdar/">Connect with me</Link></div>
    </div>
    <div class="contact-panel">
      <h2>Write a message</h2>
      <p class="contact-hint">{ready ? 'Leave your email so I can reply.' : 'The message form is temporarily unavailable. You can reach me by email.'}</p>
      {sent && <p class="form-status" role="status">Your message was received.</p>}
      {notice && <p class="form-status" role="alert">{notice}</p>}
      <form method="post" data-contact-form>
        <div class="contact-fields">
          <label>Name<input name="name" autocomplete="name" required maxlength="100" value={values.name} /></label>
          <label>Email<input name="email" type="email" autocomplete="email" spellcheck="false" required maxlength="254" value={values.email} /></label>
        </div>
        <label>Topic<select name="topic" required><option value="">Select a topic</option>{topics.map(topic => <option selected={values.topic === topic} value={topic}>{topic}</option>)}</select></label>
        <label>Message<textarea name="message" required maxlength="2800" rows="6">{values.message || ''}</textarea></label>
        <p class="form-count" data-message-count hidden></p>
        <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="button" data-send disabled={!ready}>Send message</button>
      </form>
    </div>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const message = form?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const count = form?.querySelector<HTMLElement>('[data-message-count]');
  if (message && count) {
    const update = () => { count.textContent = message.value.length + ' / ' + message.maxLength; };
    count.hidden = false;
    message.addEventListener('input', update);
    update();
  }
  if (form) {
    const button = form?.querySelector<HTMLButtonElement>('[data-send]');
    const ready = button && !button.disabled;
    form?.addEventListener('submit', () => {
      if (!button || !ready) return;
      button.disabled = true;
      button.textContent = 'Sending…';
    });
    window.addEventListener('pageshow', () => {
      if (!button || !ready) return;
      button.disabled = false;
      button.textContent = 'Send message';
    });
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const feedback = document.querySelector<HTMLElement>('[data-copy-status]');
  if (copy && feedback && navigator.clipboard) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copyEmail || '');
        feedback.textContent = 'Address copied.';
      } catch {
        feedback.textContent = 'Copy is unavailable. Select the address above to copy it.';
      }
    });
  }
</script>
