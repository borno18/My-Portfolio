---
export const prerender = false;
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import ProjectList from '../components/ProjectList.astro';
import { getProjectSettings } from '../lib/content.js';
import { projectDisplay } from '../lib/work.js';
import { cachePublic, publicCacheTags } from '../lib/public-cache.js';

const projects = projectDisplay(await getProjectSettings()).filter(project => project.featured);
cachePublic(Astro.response.headers, publicCacheTags.projects);
---
<Base title="Projects" description="Selected software projects and GitHub repositories by Joydip Majumdar.">
  <section class="wrap page-intro">
    <h1>Projects</h1>
    <p>Selected web and mobile applications.</p>
    <div class="actions"><Link href="https://github.com/borno18">GitHub profile</Link></div>
  </section>
  <div class="wrap projects-index"><ProjectList {projects} heading="h2" /></div>
</Base>
