---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { env, renderMarkdown } from '../lib/content.js';
import { adminSections, changePostVisibility, createPhotoAlbum, featureRepository, parsePost, photoFields, recordId, reorderPhotos, savePost, saveProjectSettings, setPhotoPlacement, updateInbox, validRecordId } from '../lib/admin.js';
import { projectDisplay } from '../lib/work.js';
import { listRepositories } from '../lib/github.js';
import { clearPublicCache } from '../lib/public-cache.js';
import AdminIcon from '../components/AdminIcon.astro';
import AdminInbox from '../components/AdminInbox.astro';
import AdminBlog from '../components/AdminBlog.astro';
import AdminBlogResults from '../components/AdminBlogResults.astro';
import AdminPhotos from '../components/AdminPhotos.astro';
import AdminProjects from '../components/AdminProjects.astro';
import '../admin.css';
import { authClient, ownerSession, sameOrigin, field, InputError, editPhoto, publishPhoto, removePhoto } from '../lib/server.js';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const db = authClient(Astro);
const canUpload = ['CLOUDINARY_CLOUD_NAME', 'CLOUDINARY_API_KEY', 'CLOUDINARY_API_SECRET'].every(key => env(key));
const inboxReady = /^[a-f0-9]{64}$/.test(env('CONTACT_INBOX_KEY') || '');
const params = Astro.url.searchParams;
const section = Object.hasOwn(adminSections, params.get('section')) ? params.get('section') : 'blog';
const editing = section === 'blog' ? params.get('edit') : null;
const blogStates = ['draft', 'published', 'scheduled', 'archived'];
const allowedStatuses = { blog: blogStates, inbox: ['unread', 'read', 'starred'], photos: [], projects: ['featured', 'unfeatured'] };
const filter = allowedStatuses[section].includes(params.get('status')) ? params.get('status') : '';
const search = (params.get('q') || '').trim().slice(0, 100);
const statuses = new Map([
  ['yes', 'Saved. Changes are live.'],
  ['draft', 'Draft saved.'],
  ['archived', 'Article archived.'],
  ['scheduled', 'Publication scheduled.'],
  ['unpublished', 'Article moved to drafts.'],
  ['deleted', 'Article deleted.'],
  ['message', 'Message status updated.'],
  ['message-deleted', 'Message deleted.'],
  ['photo-uploaded', 'Photograph uploaded.'],
  ['photo-saved', 'Photograph changes saved.'],
  ['photo-removed', 'Photographs removed.'],
  ['photo-order', 'Display order saved.'],
  ['photo-partial', 'Some photographs were removed. Review the remaining photographs before retrying.'],
  ['album', 'Album created.'],
  ['project', 'Project placement saved.'],
]);
let notice = statuses.get(params.get('saved')) || '';
let factor;
let qr;
const owner = db ? await ownerSession(db) : { user: null, verified: false };
const articleListRequest = Astro.request.method === 'GET' && section === 'blog' && params.get('view') === 'article-list';
if (articleListRequest && !owner.verified) return new Response(null, { status: 401, headers: { 'Cache-Control': 'private, no-store' } });
let items = [];
let post;
let preview;
let originalSlug = '';
let repositories = [];
let hasNext = false;
let githubUnavailable = false;
let syncedAt;
const repoLanguage = (params.get('language') || '').slice(0, 60);
const repoSort = ['name', 'stars', 'placement'].includes(params.get('sort')) ? params.get('sort') : 'updated';
const projectUrl = (page, saved) => {
  const query = new URLSearchParams({ section: 'projects' });
  if (search) query.set('q', search);
  if (filter) query.set('status', filter);
  if (repoLanguage) query.set('language', repoLanguage);
  if (repoSort !== 'updated') query.set('sort', repoSort);
  if (page > 1) query.set('page', String(page));
  if (saved) query.set('saved', saved);
  return '/admin?' + query;
};
let editedPhotoId;
let albums = [];
let photoTotal = 0;
let album = params.get('album') || '';
const photoCategory = (params.get('category') || '').slice(0, 40);
const photoSort = ['recent', 'title'].includes(params.get('sort')) ? params.get('sort') : 'order';
const photoUrl = ({ id = params.get('photo'), albumId = album, category = photoCategory, q = search, sort = photoSort, saved } = {}) => {
  const query = new URLSearchParams({ section: 'photos' });
  if (albumId) query.set('album', albumId);
  if (category) query.set('category', category);
  if (q) query.set('q', q);
  if (sort !== 'order') query.set('sort', sort);
  if (id) query.set('photo', id);
  if (saved) query.set('saved', saved);
  return '/admin?' + query;
};
const photoSaved = async (saved, options = {}) => {
  if (saved !== 'album') await clearPublicCache('photos');
  return Astro.redirect(photoUrl({ ...options, saved }), 303);
};
let unread = 0;
let postCount = 0;
const postSize = 5;
const now = new Date().toISOString();
const postStatus = row => row.status === 'published' && Date.parse(row.published_at) > Date.parse(now) ? 'scheduled' : row.status;
const postFilter = (query, status) => {
  if (status === 'published') return query.eq('status', 'published').lte('published_at', now);
  if (status === 'scheduled') return query.eq('status', 'published').gt('published_at', now);
  return blogStates.includes(status) ? query.eq('status', status) : query;
};
const blogUrl = (edit, { page = repoPage, status = filter, q = search, saved } = {}) => {
  const query = new URLSearchParams({ section: 'blog' });
  if (q) query.set('q', q);
  if (status) query.set('status', status);
  if (page > 1) query.set('page', String(page));
  if (edit) query.set('edit', edit);
  if (saved) query.set('saved', saved);
  return '/admin?' + query;
};
const repoPage = Math.max(1, Math.min(100, Number.parseInt(params.get('page'), 10) || 1));

if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Forbidden', { status: 403 });
  if (!db) return new Response('Admin is unavailable', { status: 503 });
  if (Number(Astro.request.headers.get('content-length')) > 3800000) return new Response('Upload is too large', { status: 413 });
  let action;
  try {
    const form = await Astro.request.formData();
    action = form.get('action');
    if (action === 'login') {
      const password = form.get('password');
      if (typeof password !== 'string' || !password.length || password.length > 256) throw new InputError('Check your password and try again.');
      const { error } = await db.auth.signInWithPassword({ email: field(form, 'email', 254), password });
      if (error || !(await ownerSession(db)).user) {
        await db.auth.signOut({ scope: 'local' });
        throw new InputError('Could not sign in. Check your credentials.');
      }
      return Astro.redirect('/admin', 303);
    }
    if (!owner.user) return new Response('Unauthorized', { status: 401 });
    if (action === 'logout') {
      await db.auth.signOut({ scope: 'local' });
      return Astro.redirect('/admin', 303);
    }
    if (action === 'enroll' && !owner.verified) {
      const listed = await db.auth.mfa.listFactors();
      if (listed.error) throw listed.error;
      if (listed.data.totp.length) throw new InputError('An authenticator is already enrolled. Enter its code.');
      for (const old of listed.data.all.filter(item => item.status === 'unverified' && item.factor_type === 'totp')) {
        const removed = await db.auth.mfa.unenroll({ factorId: old.id });
        if (removed.error) throw removed.error;
      }
      const result = await db.auth.mfa.enroll({ factorType: 'totp', friendlyName: 'Portfolio', issuer: 'Joydip Portfolio' });
      if (result.error) throw result.error;
      factor = result.data.id;
      if (result.data.totp.qr_code.startsWith('data:image/svg+xml;')) qr = result.data.totp.qr_code;
      notice = 'Scan the code with your authenticator app, then enter its six-digit code.';
    } else if (action === 'verify' && !owner.verified) {
      const code = field(form, 'code', 6);
      if (!/^\d{6}$/.test(code)) throw new InputError('Enter a six-digit authenticator code.');
      const result = await db.auth.mfa.challengeAndVerify({ factorId: field(form, 'factor', 36), code });
      if (result.error) throw new InputError('That code could not be verified. Try a fresh code.');
      return Astro.redirect('/admin', 303);
    } else if (!owner.verified) {
      return new Response('Authenticator verification required', { status: 403 });
    } else if (action === 'live-preview' && section === 'blog') {
      const html = renderMarkdown(field(form, 'body', 65000, true), Astro.site, Astro.url);
      return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'private, no-store', 'X-Robots-Tag': 'noindex, nofollow' } });
    } else if (['preview-post', 'save-draft', 'save-archive', 'publish-post'].includes(action)) {
      originalSlug = field(form, 'original_slug', 100, true);
      const draft = parsePost(form, action === 'preview-post');
      const previous = originalSlug ? await db.from('portfolio_posts').select('status,cover_path,cover_alt,updated_at,published_at').eq('slug', originalSlug).single() : null;
      if (previous?.error) throw previous.error;
      post = { ...previous?.data, ...draft, status: previous?.data.status || 'draft', featured: form.get('featured') === 'yes',
        cover_alt: form.get('cover_alt'), scheduleInput: form.get('publish_at'), removeCover: form.get('remove_cover') === 'yes' };
      if (action === 'preview-post') {
        preview = renderMarkdown(post.body, Astro.site, Astro.url);
      } else {
        const { changedPublic, scheduled } = await savePost(db, draft, originalSlug, action === 'publish-post', form);
        if (changedPublic) await clearPublicCache('blog');
        const saved = { 'save-draft': 'draft', 'save-archive': 'archived', 'publish-post': scheduled ? 'scheduled' : 'yes' }[action];
        return Astro.redirect(blogUrl(draft.slug, { saved }), 303);
      }
    } else if (action === 'unpublish-post' || action === 'delete-post') {
      await changePostVisibility(db, form, action === 'delete-post');
      await clearPublicCache('blog');
      return Astro.redirect(blogUrl(null, { saved: action === 'delete-post' ? 'deleted' : 'unpublished' }), 303);
    } else if (action === 'publish-photo') {
      await publishPhoto(db, form, photoFields(form));
      return photoSaved('photo-uploaded', { id: null });
    } else if (action === 'edit-photo') {
      editedPhotoId = recordId(form);
      await editPhoto(db, editedPhotoId, photoFields(form), form.get('photo'));
      return photoSaved('photo-saved', { id: editedPhotoId });
    } else if (action === 'remove-photo') {
      if (form.get('confirm') !== 'yes') throw new InputError('Confirm which photograph you want to remove.');
      await removePhoto(db, recordId(form));
      return photoSaved('photo-removed', { id: null });
    } else if (action === 'create-album') {
      const id = await createPhotoAlbum(db, form);
      return photoSaved('album', { albumId: id, category: '', q: '', id: null });
    } else if (['feature-photos', 'unfeature-photos', 'hide-photos', 'show-photos', 'move-photos'].includes(action)) {
      const count = await setPhotoPlacement(db, form, action);
      if (!count) throw new InputError('The selected photographs are no longer available.');
      return photoSaved('photo-saved');
    } else if (action === 'reorder-photos') {
      await reorderPhotos(db, form);
      return photoSaved('photo-order');
    } else if (action === 'remove-photos') {
      const ids = [...new Set(form.getAll('id'))];
      if (form.get('confirm') !== 'yes' || !ids.length || ids.length > 5 || !ids.every(validRecordId)) throw new InputError('Select and confirm up to five photographs to remove at a time.');
      let removed = 0;
      try {
        for (const id of ids) {
          await removePhoto(db, id);
          removed++;
        }
      } catch (error) {
        if (!removed) throw error;
        return photoSaved('photo-partial', { id: null });
      }
      return photoSaved('photo-removed', { id: null });
    } else if (['mark-message', 'star-message', 'delete-message'].includes(action)) {
      await updateInbox(db, form, action);
      const next = new URLSearchParams({ section: 'inbox', saved: action === 'delete-message' ? 'message-deleted' : 'message' });
      for (const key of ['q', 'status', 'message', 'page']) {
        if (params.has(key) && (key !== 'message' || action !== 'delete-message')) next.set(key, params.get(key));
      }
      return Astro.redirect('/admin?' + next, 303);
    } else if (['save-project', 'toggle-project', 'feature-repository'].includes(action)) {
      if (action !== 'feature-repository') await saveProjectSettings(db, form, action === 'toggle-project');
      else await featureRepository(db, form);
      await clearPublicCache('projects');
      return Astro.redirect(projectUrl(repoPage, 'project'), 303);
    } else {
      return new Response('Invalid operation', { status: 400 });
    }
  } catch (error) {
    if (action === 'live-preview') return new Response(null, { status: error instanceof InputError ? 400 : 502, headers: { 'Cache-Control': 'private, no-store' } });
    Astro.response.status = error instanceof InputError ? 400 : 502;
    if (!(error instanceof InputError)) console.error('Admin operation failed', { action, code: error?.code, status: error?.http_code });
    notice = error instanceof InputError ? error.message : action === 'publish-photo'
      ? 'The photograph could not be saved. Check the gallery before trying again.'
      : 'The request failed. Check the dashboard before trying again.';
  }
}

if (owner.user && !owner.verified && !factor) {
  const { data } = await db.auth.mfa.listFactors();
  factor = data?.totp?.[0]?.id;
}
if (owner.verified) {
  const unreadCount = articleListRequest ? 0 : db.from('portfolio_messages').select('id', { count: 'exact', head: true }).is('read_at', null).then(result => result.count ?? 0);
  let result;
  if (section === 'blog') {
    const posts = db.from('portfolio_posts');
    const matching = query => search ? query.ilike('title', '%' + search.replace(/[\\%_]/g, '\\$&') + '%') : query;
    const list = postFilter(matching(posts.select('slug,title,status,published_at,updated_at,cover_path,cover_alt', { count: 'exact' })), filter)
      .order('updated_at', { ascending: false, nullsFirst: false }).order('published_at', { ascending: false, nullsFirst: false })
      .order('slug').range((repoPage - 1) * postSize, repoPage * postSize - 1);
    const listed = await list;
    result = listed;
    items = listed.data || [];
    postCount = listed.count ?? 0;
    hasNext = listed.count > repoPage * postSize;
    if (articleListRequest) originalSlug = editing || '';
    else if (!post) {
      originalSlug = editing === '_new' ? '' : editing || items[0]?.slug || '';
      if (originalSlug) {
        const detail = await posts.select('slug,title,description,body,status,cover_path,cover_alt,featured,updated_at,published_at').eq('slug', originalSlug).maybeSingle();
        post = detail.data;
        if (detail.error) result = detail;
        if (!post && editing && !detail.error) Astro.response.status = 404;
      } else if (editing === '_new') {
        post = { slug: '', title: '', description: '', body: '', status: 'draft' };
      }
    }
  } else if (section === 'photos') {
    const [gallery, photoAlbums] = await Promise.all([
      db.from('portfolio_photos').select('id,title,alt,category,caption,display_order,bundled_key,cloud_name,public_id,version,width,height,created_at,album_id,visible,featured,tags', { count: 'exact' })
        .order('display_order').order('created_at', { ascending: false }).order('id'),
      db.from('portfolio_photo_albums').select('id,name').order('name'),
    ]);
    result = gallery.error ? gallery : photoAlbums;
    albums = photoAlbums.data || [];
    if (!albums.some(entry => entry.id === album)) album = '';
    photoTotal = gallery.count ?? 0;
    items = gallery.data || [];
  } else if (section === 'inbox') {
    let query = db.from('portfolio_messages').select('id,name,email,message,read_at,starred,created_at', { count: 'exact' })
      .order('created_at', { ascending: false }).order('id').range((repoPage - 1) * 30, repoPage * 30 - 1);
    if (filter === 'unread') query = query.is('read_at', null);
    if (filter === 'read') query = query.not('read_at', 'is', null);
    if (filter === 'starred') query = query.eq('starred', true);
    if (search) query = query.ilike('search_text', '%' + search.replace(/[\\%_]/g, '\\$&') + '%');
    result = await query;
    items = result.data || [];
    hasNext = result.count > repoPage * 30;
  } else {
    const [settings, github] = await Promise.allSettled([
      db.from('portfolio_project_settings').select('slug,featured,display_order,repository'),
      listRepositories(params.get('sync') === 'yes'),
    ]);
    result = settings.status === 'fulfilled' ? settings.value : { error: settings.reason };
    items = projectDisplay(result.data || []);
    if (github.status === 'fulfilled') {
      repositories = github.value.repositories;
      syncedAt = github.value.syncedAt;
      githubUnavailable = Boolean(github.value.stale);
    } else {
      githubUnavailable = true;
    }
  }
  if (result?.error) {
    Astro.response.status = 502;
    notice ||= 'This section could not be loaded. Try again in a moment.';
  }
  unread = await unreadCount;
}
---
{articleListRequest ? <AdminBlogResults {items} {originalSlug} {postCount} {postStatus} {blogUrl} page={repoPage} {hasNext} /> :
<Base title="Owner dashboard" description="Private portfolio publishing." privatePage adminBar={owner.verified && section === 'blog'} bodyClass={owner.verified ? 'admin-page admin-page-' + section : undefined}>
  <div class:list={['admin', owner.verified ? 'wrap admin-workspace' : 'reading']}>
    {owner.verified ? <>
      <div class="admin-top">
        <div><h1>Portfolio admin</h1>{section !== 'blog' && <p>Manage articles, photographs, inbox, and featured projects.</p>}</div>
        {section !== 'blog' && <div class="actions">
          <form method="post"><button name="action" value="logout" class="btn btn-outline button secondary">Sign out</button></form>
        </div>}
      </div>
      {notice && <p role="status">{notice}</p>}
      <div class="admin-grid">
        <nav class="admin-nav" aria-label="Admin sections">
          {Object.entries(adminSections).map(([key, label]) => <a href={'/admin?section=' + key} aria-current={key === section ? 'page' : undefined}>
            <AdminIcon name={key} />{label}
            {key === 'inbox' && unread > 0 && <span class="badge admin-count" aria-label={unread + ' unread'}>{unread}</span>}
          </a>)}
          {section === 'photos' && <div class="admin-albums">
            <h2>Albums</h2>
            <a href={photoUrl({ albumId: '', category: '', q: '', id: null })} aria-current={!album ? 'true' : undefined}><AdminIcon name="folder" />All photos <span class="badge admin-count">{photoTotal}</span></a>
            {albums.map(entry => <a href={photoUrl({ albumId: entry.id, category: '', q: '', id: null })} aria-current={album === entry.id ? 'true' : undefined}>
              <AdminIcon name="folder" />{entry.name}<span class="badge admin-count">{items.filter(photo => photo.album_id === entry.id).length}</span>
            </a>)}
            <details><summary class="button secondary"><AdminIcon name="plus" />New album</summary>
              <form method="post" action={photoUrl()}><label>Album name<input name="album_name" required maxlength="40" /></label><button class="button" name="action" value="create-album">Create album</button></form>
            </details>
          </div>}
        </nav>
        <div class:list={['admin-main', 'admin-' + section]}>
          {section === 'blog' && <AdminBlog {items} {post} {originalSlug} {preview} {editing} {search} {filter} {postCount} {postStatus} {blogUrl} page={repoPage} {hasNext} />}
          {section === 'inbox' && <AdminInbox {items} {unread} {search} {filter} {inboxReady} {hasNext} page={repoPage} selectedId={params.get('message')} />}
          {section === 'photos' && <AdminPhotos {items} {albums} {album} {photoCategory} {photoSort} {photoTotal} {search} {canUpload} {photoUrl}
            selectedId={editedPhotoId || params.get('photo')} uploadOpen={params.get('upload') === 'yes'} />}
          {section === 'projects' && <AdminProjects projects={items} {repositories} {githubUnavailable} {syncedAt} {search}
            repoFilter={filter} {repoLanguage} {repoSort} page={repoPage} {projectUrl} />}
        </div>
      </div>
    </> : <>
      <section class="page-intro"><h1>Portfolio admin</h1><p>Owner sign-in for portfolio publishing.</p></section>
      {notice && <p role="status">{notice}</p>}
    {!db ? <p class="form-status">Owner sign-in requires a connected Supabase account.</p> : !owner.user ? (
      <form method="post" action="/admin">
        <input type="hidden" name="action" value="login" />
        <label>Email<input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required maxlength="256" /></label>
        <button type="submit" class="button">Sign in</button>
      </form>
    ) : <>
      <form method="post"><button name="action" value="logout" class="button secondary">Sign out</button></form>
      {!owner.verified ? (
        factor ? <form method="post">
          {qr && <img src={qr} alt="QR code for adding the portfolio to your authenticator" width="188" height="188" />}
          <input type="hidden" name="factor" value={factor} /><input type="hidden" name="action" value="verify" />
          <label>Authenticator code<input name="code" autocomplete="one-time-code" spellcheck="false" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required /></label>
          <button class="button">Verify</button>
          {qr && <button name="action" value="enroll" formnovalidate class="button secondary">Restart setup</button>}
        </form> : <form method="post"><p>Set up an authenticator before opening the dashboard.</p><button name="action" value="enroll" class="button">Set up authenticator</button></form>
      ) : null}
    </>}
    </>}
  </div>
</Base>}
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-photo-upload]')) {
    const input = form.querySelector<HTMLInputElement>('input[type=file]');
    const button = form.querySelector<HTMLButtonElement>('button');
    const status = form.querySelector<HTMLElement>('[data-upload-status]');
    if (!input || !button || !status) continue;
    form.addEventListener('submit', async event => {
      const file = input.files?.[0];
      if (!file) return;
      event.preventDefault();
      button.disabled = true;
      status.hidden = false;
      status.textContent = 'Preparing photograph…';
      try {
        const image = await createImageBitmap(file);
        const resized = file.size > 3500000 || image.width * image.height > 32000000;
        if (resized) {
          const scale = Math.min(1, 2000 / Math.max(image.width, image.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(image.width * scale));
          canvas.height = Math.max(1, Math.round(image.height * scale));
          const context = canvas.getContext('2d');
          if (!context) throw new Error();
          context.fillStyle = '#fff';
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          const blob = await new Promise<Blob | null>(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.88));
          if (!blob || blob.size > 3500000) throw new Error();
          const transfer = new DataTransfer();
          transfer.items.add(new File([blob], 'photograph.jpg', { type: 'image/jpeg' }));
          input.files = transfer.files;
        }
        image.close();
        status.textContent = 'Uploading photograph…';
        form.submit();
      } catch {
        status.textContent = 'Could not prepare this photograph. Choose a JPEG, PNG, or WebP image.';
        button.disabled = false;
      }
    });
  }
</script>
