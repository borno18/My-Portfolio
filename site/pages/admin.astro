---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { cloudImage, env, renderMarkdown } from '../lib/content.js';
import { adminSections, changePostVisibility, featureRepository, parsePost, photoFields, recordId, savePost, saveProjectSettings, updateInbox } from '../lib/admin.js';
import { projectDisplay } from '../lib/work.js';
import { listRepositories } from '../lib/github.js';
import AdminPostEditor from '../components/AdminPostEditor.astro';
import AdminPhotoFields from '../components/AdminPhotoFields.astro';
import '../admin.css';
import { authClient, ownerSession, sameOrigin, field, InputError, publishPhoto, removePhoto } from '../lib/server.js';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const db = authClient(Astro);
const canUpload = ['CLOUDINARY_CLOUD_NAME', 'CLOUDINARY_API_KEY', 'CLOUDINARY_API_SECRET'].every(key => env(key));
const inboxReady = /^[a-f0-9]{64}$/.test(env('CONTACT_INBOX_KEY') || '');
const params = Astro.url.searchParams;
const section = Object.hasOwn(adminSections, params.get('section')) ? params.get('section') : 'blog';
const editing = section === 'blog' ? params.get('edit') : null;
const filter = ['draft', 'published', 'unread', 'read'].includes(params.get('status')) ? params.get('status') : '';
const search = (params.get('q') || '').trim().slice(0, 100);
const statuses = new Map([['yes', 'Saved. Changes are live.'], ['draft', 'Draft saved.'], ['unpublished', 'Article moved to drafts.'], ['deleted', 'Article deleted.'], ['message', 'Message status updated.']]);
let notice = statuses.get(params.get('saved')) || '';
let factor;
let qr;
const owner = db ? await ownerSession(db) : { user: null, verified: false };
let items = [];
let post;
let preview;
let originalSlug = '';
let repositories = [];
let hasNext = false;
let githubUnavailable = false;
const repoPage = Math.max(1, Math.min(100, Number.parseInt(params.get('page'), 10) || 1));
const redirectSaved = (target, saved) => Astro.redirect('/admin?section=' + target + '&saved=' + saved, 303);

if (Astro.request.method === 'POST') {
  if (!sameOrigin(Astro.request)) return new Response('Forbidden', { status: 403 });
  if (!db) return new Response('Admin is unavailable', { status: 503 });
  if (Number(Astro.request.headers.get('content-length')) > 3800000) return new Response('Upload is too large', { status: 413 });
  let action;
  try {
    const form = await Astro.request.formData();
    action = form.get('action');
    if (action === 'login') {
      const password = form.get('password');
      if (typeof password !== 'string' || !password.length || password.length > 256) throw new InputError('Check your password and try again.');
      const { error } = await db.auth.signInWithPassword({ email: field(form, 'email', 254), password });
      if (error || !(await ownerSession(db)).user) {
        await db.auth.signOut({ scope: 'local' });
        throw new InputError('Could not sign in. Check your credentials.');
      }
      return Astro.redirect('/admin', 303);
    }
    if (!owner.user) return new Response('Unauthorized', { status: 401 });
    if (action === 'logout') {
      await db.auth.signOut({ scope: 'local' });
      return Astro.redirect('/admin', 303);
    }
    if (action === 'enroll' && !owner.verified) {
      const listed = await db.auth.mfa.listFactors();
      if (listed.error) throw listed.error;
      if (listed.data.totp.length) throw new InputError('An authenticator is already enrolled. Enter its code.');
      for (const old of listed.data.all.filter(item => item.status === 'unverified' && item.factor_type === 'totp')) {
        const removed = await db.auth.mfa.unenroll({ factorId: old.id });
        if (removed.error) throw removed.error;
      }
      const result = await db.auth.mfa.enroll({ factorType: 'totp', friendlyName: 'Portfolio', issuer: 'Joydip Portfolio' });
      if (result.error) throw result.error;
      factor = result.data.id;
      if (result.data.totp.qr_code.startsWith('data:image/svg+xml;')) qr = result.data.totp.qr_code;
      notice = 'Scan the code with your authenticator app, then enter its six-digit code.';
    } else if (action === 'verify' && !owner.verified) {
      const code = field(form, 'code', 6);
      if (!/^\d{6}$/.test(code)) throw new InputError('Enter a six-digit authenticator code.');
      const result = await db.auth.mfa.challengeAndVerify({ factorId: field(form, 'factor', 36), code });
      if (result.error) throw new InputError('That code could not be verified. Try a fresh code.');
      return Astro.redirect('/admin', 303);
    } else if (!owner.verified) {
      return new Response('Authenticator verification required', { status: 403 });
    } else if (['preview-post', 'save-draft', 'publish-post'].includes(action)) {
      originalSlug = field(form, 'original_slug', 100, true);
      const draft = parsePost(form, action === 'preview-post');
      const previous = originalSlug ? await db.from('portfolio_posts').select('status,cover_path,cover_alt').eq('slug', originalSlug).single() : null;
      if (previous?.error) throw previous.error;
      post = { ...previous?.data, ...draft, status: previous?.data.status || 'draft' };
      if (action === 'preview-post') {
        preview = renderMarkdown(post.body, Astro.site, Astro.url);
      } else {
        const changedPublic = await savePost(db, draft, originalSlug, action === 'publish-post', form);
        return redirectSaved('blog', changedPublic ? 'yes' : 'draft');
      }
    } else if (action === 'unpublish-post' || action === 'delete-post') {
      await changePostVisibility(db, form, action === 'delete-post');
      return redirectSaved('blog', action === 'delete-post' ? 'deleted' : 'unpublished');
    } else if (action === 'publish-photo') {
      await publishPhoto(db, form, photoFields(form));
      return redirectSaved('photos', 'yes');
    } else if (action === 'edit-photo') {
      const saved = await db.from('portfolio_photos').update(photoFields(form)).eq('id', recordId(form)).select('id').single();
      if (saved.error) throw saved.error;
      return redirectSaved('photos', 'yes');
    } else if (action === 'remove-photo') {
      if (form.get('confirm') !== 'yes') throw new InputError('Confirm which photograph you want to remove.');
      await removePhoto(db, recordId(form));
      return redirectSaved('photos', 'yes');
    } else if (action === 'mark-message') {
      await updateInbox(db, form);
      return redirectSaved('inbox', 'message');
    } else if (action === 'save-project') {
      await saveProjectSettings(db, form);
      return redirectSaved('projects', 'yes');
    } else if (action === 'feature-repository') {
      await featureRepository(db, form);
      return redirectSaved('projects', 'yes');
    } else {
      return new Response('Invalid operation', { status: 400 });
    }
  } catch (error) {
    Astro.response.status = error instanceof InputError ? 400 : 502;
    if (!(error instanceof InputError)) console.error('Admin operation failed', { action, code: error?.code, status: error?.http_code });
    notice = error instanceof InputError ? error.message : action === 'publish-photo'
      ? 'The photograph could not be saved. Check the gallery before trying again.'
      : 'The request failed. Check the dashboard before trying again.';
  }
}

if (owner.user && !owner.verified && !factor) {
  const { data } = await db.auth.mfa.listFactors();
  factor = data?.totp?.[0]?.id;
}
if (owner.verified) {
  let result;
  if (section === 'blog' && editing) {
    if (!post) {
      originalSlug = editing === '_new' ? '' : editing;
      if (originalSlug) {
        result = await db.from('portfolio_posts').select('slug,title,description,body,status,cover_path,cover_alt').eq('slug', originalSlug).maybeSingle();
        post = result.data;
        if (!post && !result.error) Astro.response.status = 404;
      } else {
        post = { slug: '', title: '', description: '', body: '', status: 'draft' };
      }
    }
  } else if (section === 'blog') {
    let query = db.from('portfolio_posts').select('slug,title,status,published_at').order('published_at', { ascending: false }).order('slug');
    if (['draft', 'published'].includes(filter)) query = query.eq('status', filter);
    result = await query;
    items = (result.data || []).filter(item => !search || (item.title + ' ' + item.slug).toLowerCase().includes(search.toLowerCase()));
  } else if (section === 'photos') {
    result = await db.from('portfolio_photos').select('id,title,alt,category,caption,display_order,cloud_name,public_id,version').order('display_order').order('created_at', { ascending: false });
    items = result.data || [];
  } else if (section === 'inbox') {
    let query = db.from('portfolio_messages').select('id,name,email,message,read_at,created_at').order('created_at', { ascending: false }).limit(100);
    if (filter === 'unread') query = query.is('read_at', null);
    if (filter === 'read') query = query.not('read_at', 'is', null);
    result = await query;
    items = result.data || [];
  } else {
    const [settings, github] = await Promise.allSettled([
      db.from('portfolio_project_settings').select('slug,featured,display_order,repository'),
      listRepositories(repoPage),
    ]);
    result = settings.status === 'fulfilled' ? settings.value : { error: settings.reason };
    items = projectDisplay(result.data || []);
    if (github.status === 'fulfilled') {
      const imported = new Set(items.map(project => project.repo.toLowerCase().split('/').at(-1)));
      repositories = github.value.repositories.filter(repo => !imported.has(repo.name.toLowerCase()));
      hasNext = github.value.hasNext;
    } else {
      githubUnavailable = true;
    }
  }
  if (result?.error) {
    Astro.response.status = 502;
    notice ||= 'This section could not be loaded. Try again in a moment.';
  }
}
const formatDate = date => new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'Asia/Dhaka' }).format(new Date(date));
---
<Base title="Owner dashboard" description="Private portfolio publishing." privatePage>
  <div class:list={['admin', owner.verified ? 'wrap admin-workspace' : 'reading']}>
    {owner.verified ? <>
      <div class="admin-top">
        <div><h1>Portfolio admin</h1><p>Manage articles, photographs, inbox, and featured projects.</p></div>
        <div class="actions">
          <form method="post"><button name="action" value="logout" class="button secondary">Sign out</button></form>
        </div>
      </div>
      {notice && <p role="status">{notice}</p>}
      <div class="admin-grid">
        <nav class="admin-nav" aria-label="Admin sections">
          {Object.entries(adminSections).map(([key, label]) => <a href={'/admin?section=' + key} aria-current={key === section ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="admin-main">
          {section === 'blog' && (editing ? (
            post ? <AdminPostEditor {post} {originalSlug} {preview} {editing} /> :
              <><h2>Article unavailable</h2><p class="admin-empty"><a href="/admin?section=blog">Back to posts</a></p></>
          ) : <>
            <div class="admin-heading"><h2>Blog posts</h2><a class="button" href="/admin?section=blog&amp;edit=_new">New article</a></div>
            <form method="get" class="admin-tools">
              <input type="hidden" name="section" value="blog" />
              <label>Search<input name="q" type="search" maxlength="100" value={search} /></label>
              <label>Status<select name="status"><option value="">All statuses</option><option value="draft" selected={filter === 'draft'}>Draft</option><option value="published" selected={filter === 'published'}>Published</option></select></label>
              <button class="button secondary">Filter posts</button>
            </form>
            {items.length ? <ul class="admin-list">
              {items.map(item => <li>
                <div><strong>{item.title}</strong><small>{item.slug}</small></div>
                <div class="actions"><span class="admin-status">{item.status === 'published' ? 'Published' : 'Draft'}</span>
                  {item.published_at && <time datetime={item.published_at}>{formatDate(item.published_at)}</time>}
                  <a href={'/admin?section=blog&edit=' + encodeURIComponent(item.slug)} aria-label={'Edit ' + item.title}>Edit</a>
                  {item.status === 'published' && <form method="post">
                    <input type="hidden" name="slug" value={item.slug} />
                    <button class="button secondary" name="action" value="unpublish-post" aria-label={'Unpublish ' + item.title}>Unpublish</button>
                  </form>}</div>
              </li>)}
            </ul> : <p class="admin-empty">No articles match this view.</p>}
          </>)}
          {section === 'inbox' && <>
            <h2>Inbox</h2>
            {!inboxReady && <p class="form-status">The message form is temporarily unavailable.</p>}
            <form method="get" class="admin-tools"><input type="hidden" name="section" value="inbox" />
              <label>Status<select name="status"><option value="">All messages</option><option value="unread" selected={filter === 'unread'}>Unread</option><option value="read" selected={filter === 'read'}>Read</option></select></label>
              <button class="button secondary">Filter inbox</button>
            </form>
            {items.length ? items.map(item => <details class="admin-inbox-item"><summary>{item.name} · {item.read_at ? 'Read' : 'Unread'}</summary>
              <time datetime={item.created_at}>{formatDate(item.created_at)}</time>
              <p><a href={'mailto:' + encodeURIComponent(item.email).replace('%40','@')}>Reply to {item.email}</a></p>
              <p class="admin-message">{item.message}</p>
              <form method="post"><input type="hidden" name="id" value={item.id} />
                <input type="hidden" name="read" value={item.read_at ? 'no' : 'yes'} />
                <button class="button secondary" name="action" value="mark-message">Mark as {item.read_at ? 'unread' : 'read'}</button>
              </form>
            </details>) : <p class="admin-empty">No messages in this view.</p>}
          </>}
          {section === 'photos' && <>
            <h2>Photography</h2>
            {canUpload ? <details open={Astro.request.method === 'POST' && Astro.response.status >= 400}><summary>Upload photograph</summary><form method="post" enctype="multipart/form-data" data-photo-upload>
              <input type="hidden" name="action" value="publish-photo" /><AdminPhotoFields />
              <label>Photograph · JPEG, PNG, or WebP<input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required /></label>
              <p role="status" data-upload-status hidden></p>
              <button class="button">Upload and publish</button>
            </form></details> : <p class="form-status">Cloudinary credentials are required to upload or remove photographs.</p>}
            <p class="admin-empty">Lower display numbers appear first.</p>
            {items.length ? items.map(photo => <details><summary>{photo.title} · {photo.category}</summary>
              {cloudImage(photo, 360) && <img src={cloudImage(photo, 360)} alt={photo.alt} width="240" loading="lazy" />}
              <form method="post"><input type="hidden" name="id" value={photo.id} /><AdminPhotoFields {photo} />
                <button class="button" name="action" value="edit-photo">Save details</button>
              </form>
              {canUpload && <form method="post"><input type="hidden" name="id" value={photo.id} />
                <label><span><input name="confirm" type="checkbox" value="yes" required /> Confirm removal</span></label>
                <button class="button secondary" name="action" value="remove-photo">Remove from the gallery</button>
              </form>}
            </details>) : <p class="admin-empty">No uploaded photographs yet.</p>}
          </>}
          {section === 'projects' && <>
            <h2>Projects</h2><p class="admin-empty">Featured projects appear on the homepage and Projects page in display order.</p>
            {items.map(project => <details><summary>{project.name} · {project.featured ? 'Featured' : 'Unfeatured'}</summary>
              <form method="post"><input type="hidden" name="slug" value={project.slug} />
                <label><span><input name="featured" type="checkbox" value="yes" checked={project.featured} /> Feature on the site</span></label>
                <label>Display order<input type="number" name="display_order" min="0" max="999" required value={project.display_order} /></label>
                <button class="button" name="action" value="save-project">Save placement</button>
              </form>
            </details>)}
            <h3>GitHub repositories</h3>
            {githubUnavailable ? <p class="form-status">GitHub is temporarily unavailable. Refresh to try again.</p> :
              repositories.length ? <ul class="admin-list">{repositories.map(repo => <li>
                <div><strong>{repo.name}</strong>{repo.description && <small>{repo.description}</small>}</div>
                <form method="post"><input type="hidden" name="repository" value={repo.name} />
                  <button class="button secondary" name="action" value="feature-repository" aria-label={'Feature ' + repo.name}>Feature</button>
                </form>
              </li>)}</ul> : <p class="admin-empty">No additional repositories on this page.</p>}
            {(repoPage > 1 || hasNext) && <div class="actions">
              {repoPage > 1 && <a href={'/admin?section=projects&page=' + (repoPage - 1)}>Previous repositories</a>}
              {hasNext && repoPage < 100 && <a href={'/admin?section=projects&page=' + (repoPage + 1)}>Next repositories</a>}
            </div>}
          </>}
        </div>
      </div>
    </> : <>
      <section class="page-intro"><h1>Portfolio admin</h1><p>Owner sign-in for portfolio publishing.</p></section>
      {notice && <p role="status">{notice}</p>}
    {!db ? <p class="form-status">Owner sign-in requires a connected Supabase account.</p> : !owner.user ? (
      <form method="post">
        <input type="hidden" name="action" value="login" />
        <label>Email<input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required maxlength="256" /></label>
        <button class="button">Sign in</button>
      </form>
    ) : <>
      <form method="post"><button name="action" value="logout" class="button secondary">Sign out</button></form>
      {!owner.verified ? (
        factor ? <form method="post">
          {qr && <img src={qr} alt="QR code for adding the portfolio to your authenticator" width="188" height="188" />}
          <input type="hidden" name="factor" value={factor} /><input type="hidden" name="action" value="verify" />
          <label>Authenticator code<input name="code" autocomplete="one-time-code" spellcheck="false" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required /></label>
          <button class="button">Verify</button>
          {qr && <button name="action" value="enroll" formnovalidate class="button secondary">Restart setup</button>}
        </form> : <form method="post"><p>Set up an authenticator before opening the dashboard.</p><button name="action" value="enroll" class="button">Set up authenticator</button></form>
      ) : null}
    </>}
    </>}
  </div>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-photo-upload]');
  const input = form?.querySelector<HTMLInputElement>('input[type=file]');
  const button = form?.querySelector<HTMLButtonElement>('button');
  const status = form?.querySelector<HTMLElement>('[data-upload-status]');
  if (form && input && button && status) {
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const file = input.files?.[0];
      if (!file) return;
      button.disabled = true;
      status.hidden = false;
      status.textContent = 'Preparing photograph…';
      try {
        const image = await createImageBitmap(file);
        const resized = file.size > 3500000 || image.width * image.height > 32000000;
        if (resized) {
          const scale = Math.min(1, 2000 / Math.max(image.width, image.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(image.width * scale));
          canvas.height = Math.max(1, Math.round(image.height * scale));
          const context = canvas.getContext('2d');
          if (!context) throw new Error();
          context.fillStyle = '#fff';
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          const blob = await new Promise<Blob | null>(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.88));
          if (!blob || blob.size > 3500000) throw new Error();
          const transfer = new DataTransfer();
          transfer.items.add(new File([blob], 'photograph.jpg', { type: 'image/jpeg' }));
          input.files = transfer.files;
        }
        image.close();
        status.textContent = 'Uploading photograph…';
        form.submit();
      } catch {
        status.textContent = 'Could not prepare this photograph. Choose a JPEG, PNG, or WebP image.';
        button.disabled = false;
      }
    });
  }
</script>
