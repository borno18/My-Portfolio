---
export const prerender = false;
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import ProjectList from '../components/ProjectList.astro';
import ArticleTeaser from '../components/ArticleTeaser.astro';
import portrait from '../assets/joydip-portrait.webp';
import { projectDisplay } from '../lib/work.js';
import { featuredPhoto } from '../lib/photos.js';
import { getPosts, getProjectSettings } from '../lib/content.js';

Astro.response.headers.set('Cache-Control', 'no-store');
const [articles, settings] = await Promise.all([getPosts(), getProjectSettings()]);
const posts = articles.slice(0, 2);
const featuredProjects = projectDisplay(settings).filter(project => project.featured);
const person = { '@type': 'Person', name: 'Joydip Majumdar', jobTitle: 'Software Engineering Student', url: Astro.site.href, affiliation: { '@type': 'CollegeOrUniversity', name: 'Shahjalal University of Science and Technology' }, sameAs: ['https://github.com/borno18', 'https://www.linkedin.com/in/joydip-majumdar/'] };
---
<Base description="Joydip Majumdar is a software engineering student at SUST in Sylhet, Bangladesh. Explore his projects, engineering blog, and Fujifilm photography." schema={{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person }}>
  <section class="hero wrap" id="about" aria-labelledby="intro">
    <div class="hero-copy">
      <h1 id="intro">Hi, I’m Joydip Majumdar.</h1>
      <p class="role">Software engineering student at SUST</p>
      <p class="intro">I build web and mobile apps, from offline attendance tools to campus tournament software. Away from my desk, I photograph everyday life in Sylhet.</p>
      <div class="actions"><Link class="button" href="#projects">View projects</Link><Link class="button secondary" href="https://www.linkedin.com/in/joydip-majumdar/">LinkedIn</Link></div>
    </div>
    <div class="portrait-panel">
      <Image src={portrait} alt="Portrait of Joydip Majumdar" width={960} widths={[400, 640, 960]} sizes="(max-width: 680px) 86vw, 43vw" format="webp" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <section class="project-section" id="projects">
    <div class="wrap band">
      <div class="section-head"><h2>Projects</h2><Link href="/projects">View projects</Link></div>
      <ProjectList projects={featuredProjects} />
    </div>
  </section>

  <section class="band wrap news-section" id="blog">
    <div class="section-head newspaper-head"><div><h2>Blog</h2><p>Notes on building software.</p></div><Link href="/blog">View all articles</Link></div>
    <div class="newspaper-grid">{posts.map(post => <ArticleTeaser post={post} />)}</div>
  </section>

  <section class="photo-band" id="photography">
    <div class="wrap photo-feature">
      <figure><Image src={featuredPhoto.src} alt="A balcony and plants in the late afternoon sun in Sylhet" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 680px) 100vw, 48vw" format="webp" /><figcaption>A Dream Afternoon · Sylhet</figcaption></figure>
      <div><h2>Photography</h2><p>Street scenes, architecture, and festivals from Sylhet, photographed on Fujifilm.</p><Link class="button" href="/photos">Browse photographs</Link></div>
    </div>
  </section>
  <section class="band wrap homepage-contact" id="contact">
    <div><h2>Contact</h2><p>Have a project in mind, a role to discuss, or a question about a photograph?</p></div>
    <div class="actions"><Link class="button" href="/contact">Write a message</Link><Link href="https://www.linkedin.com/in/joydip-majumdar/">Connect on LinkedIn</Link></div>
  </section>
</Base>
