---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { projects } from '../lib/work.js';
import { featuredPhoto } from '../lib/photos.js';
import { getPosts } from '../lib/content.js';

const posts = (await getPosts()).slice(0, 2);
const person = { '@type': 'Person', name: 'Joydip Majumdar', jobTitle: 'Software Engineering Student', url: Astro.site.href, affiliation: { '@type': 'CollegeOrUniversity', name: 'Shahjalal University of Science and Technology' }, sameAs: ['https://github.com/borno18', 'https://www.linkedin.com/in/joydip-majumdar/'] };
---
<Base description="Joydip Majumdar is a software engineering student at SUST in Sylhet, Bangladesh. Explore his engineering projects, writing, and Fujifilm photography." schema={{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person }}>
  <section class="hero wrap" aria-labelledby="intro">
    <div>
      <h1 id="intro">Joydip <span>Majumdar</span></h1>
      <p class="role">Software engineering student at SUST</p>
      <p class="intro">I build web and mobile applications. In Sylhet, I also take my Fujifilm out to photograph the city.</p>
      <div class="actions"><a class="button" href="#projects">View selected work</a><a href="#contact">Get in touch</a></div>
    </div>
    <figure class="hero-figure">
      <a href="/work/swe-sports-week"><ProjectMedia project={projects[0]} large /></a>
      <figcaption><span>SWE Sports Week</span><span>Tournament hub for SUST</span></figcaption>
    </figure>
  </section>
  <section class="band wrap" id="projects">
    <div class="section-head"><h2>Selected work</h2><a href="https://github.com/borno18">View GitHub profile</a></div>
    <div class="work-grid">
      {projects.map(project => (
        <article class="project">
          <ProjectMedia project={project} />
          <div class="project-body">
            <span class="meta">{project.type}</span>
            <h3><a href={`/work/${project.slug}`}>{project.name}</a></h3>
            <p>{project.summary}</p>
            <span class="meta">{project.stack}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="band wrap" id="blog">
    <div class="section-head"><h2>Writing</h2><a href="/blog">All writing</a></div>
    <div class="list">{posts.map(post => <a href={`/blog/${post.slug}`}><strong>{post.title}</strong><span>{post.isProjectNote ? 'Project note' : 'Article'}</span></a>)}</div>
  </section>
  <section class="photo-band" id="photography">
    <div class="wrap photo-feature">
      <figure><Image src={featuredPhoto.src} alt="A Dream Afternoon, a street photograph taken in Sylhet" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 620px) 100vw, 55vw" format="webp" /><figcaption>A Dream Afternoon · Sylhet</figcaption></figure>
      <div><h2>Photography</h2><p>Street scenes, architecture, and festivals from Sylhet, photographed on Fujifilm.</p><a class="button" href="/photos">Browse photographs</a></div>
    </div>
  </section>
  <section class="band wrap about" id="about">
    <div><h2>About me</h2><p>I study software engineering at Shahjalal University of Science and Technology. My projects range from mobile apps that work offline to web tools for campus events.</p>
      <details><summary>Engineering activity</summary><p><a href="https://github.com/borno18">GitHub</a> · <a href="https://leetcode.com/u/nightguy01/">LeetCode</a> · <a href="https://codeforces.com/profile/nightguy01">Codeforces</a></p></details>
    </div>
    <div id="contact"><h2>Get in touch</h2><p>For questions about a project or an opportunity, send me an email or connect on LinkedIn.</p><div class="actions"><a class="button" href="mailto:joydipmajumdarborno@gmail.com">Email Joydip</a><a href="/contact">Contact form</a></div></div>
  </section>
</Base>
