---
export const prerender = false;
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import ProjectList from '../components/ProjectList.astro';
import ArticleTeaser from '../components/ArticleTeaser.astro';
import Background from '../components/Background.astro';
import portrait320 from '../assets/joydip-portrait-320.webp';
import portrait400 from '../assets/joydip-portrait-400.webp';
import portrait640 from '../assets/joydip-portrait-640.webp';
import portrait800 from '../assets/joydip-portrait-800.webp';
import { projectDisplay } from '../lib/work.js';
import { galleryPhotos } from '../lib/photos.js';
import { cloudImage, getPosts, getProjectSettings } from '../lib/content.js';
import { cachePublic, publicCacheTags } from '../lib/public-cache.js';

const [articles, settings, photos] = await Promise.allSettled([getPosts({ limit: 2, featuredFirst: true }), getProjectSettings(), galleryPhotos()]);
if ([articles, settings, photos].every(result => result.status === 'fulfilled')) {
  cachePublic(Astro.response.headers, ...Object.values(publicCacheTags));
} else {
  Astro.response.headers.set('Cache-Control', 'no-store');
  for (const result of [articles, settings, photos]) if (result.status === 'rejected') console.error(result.reason);
}
const featuredPhoto = photos.value?.find(photo => photo.featured) ?? photos.value?.find(photo => photo.bundled_key === 'a-dream-afternoon') ?? photos.value?.[0];
const featuredProjects = settings.status === 'fulfilled' ? projectDisplay(settings.value).filter(project => project.featured) : [];
const portraitSizes = [portrait320, portrait400, portrait640, portrait800]
  .map(image => image.src + ' ' + image.width + 'w').join(', ');
const person = { '@type': 'Person', name: 'Joydip Majumdar', jobTitle: 'Software Engineering Student', url: Astro.site.href, affiliation: { '@type': 'CollegeOrUniversity', name: 'Shahjalal University of Science and Technology' }, sameAs: ['https://github.com/borno18', 'https://www.linkedin.com/in/joydip-majumdar/'] };
---
<Base description="Joydip Majumdar is a software engineering student at SUST in Sylhet, Bangladesh. Explore his projects, engineering blog, and Fujifilm photography." schema={{ '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person }}>
  <section class="hero wrap" id="about" aria-labelledby="intro">
    <div class="hero-copy">
      <h1 id="intro">Joydip Majumdar</h1>
      <p class="role">Software engineering student at SUST</p>
      <p class="intro">I build web and mobile apps, from offline attendance tools to campus tournament software. Away from my desk, I photograph everyday life in Sylhet.</p>
      <div class="actions">
        <Link class="button" href="#projects">View projects</Link>
        <Link class="button secondary" href="/Joydip-Majumdar-CV.pdf" download="Joydip-Majumdar-CV.pdf">Download CV</Link>
      </div>
    </div>
    <div class="portrait-panel">
      <img src={portrait400.src} srcset={portraitSizes} sizes="(max-width: 380px) calc(100vw - 72px), (max-width: 680px) 310px, (max-width: 1000px) 33vw, 390px"
        width={portrait400.width} height={portrait400.height} alt="Portrait of Joydip Majumdar" fetchpriority="high" />
    </div>
  </section>

  <section class="project-section" id="projects">
    <div class="wrap band">
      <div class="section-head"><h2>Projects</h2><Link href="/projects">All projects</Link></div>
      {settings.status === 'fulfilled' ? <ProjectList projects={featuredProjects} /> : <p>Projects are temporarily unavailable.</p>}
    </div>
  </section>

  <Background />

  <section class="band wrap news-section" id="blog">
    <div class="section-head newspaper-head"><h2>Blog</h2><Link href="/blog">View all articles</Link></div>
    {articles.value?.length ? <div class="newspaper-grid">{articles.value.map(post => <ArticleTeaser post={post} />)}</div> :
      <p>{articles.status === 'rejected' ? 'Articles are temporarily unavailable.' : 'No articles have been published yet.'}</p>}
  </section>

  <section class="photo-band" id="photography">
    <div class:list={['wrap', { 'photo-feature': featuredPhoto }]}>
      {featuredPhoto && <figure>
        {featuredPhoto.src ? <Image src={featuredPhoto.src} alt={featuredPhoto.alt} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 680px) 100vw, 48vw" format="webp" /> :
          <img src={cloudImage(featuredPhoto, 1200)} srcset={[480, 800, 1200].map(width => cloudImage(featuredPhoto, width) + ' ' + width + 'w').join(', ')} sizes="(max-width: 680px) 100vw, 48vw" width={featuredPhoto.width} height={featuredPhoto.height} alt={featuredPhoto.alt} loading="lazy" decoding="async" />}
        <figcaption>{featuredPhoto.title}{featuredPhoto.bundled_key && featuredPhoto.caption && ' · ' + featuredPhoto.caption}</figcaption>
      </figure>}
      <div><h2>Photography</h2><p>Street scenes, architecture, and festivals from Sylhet, photographed on Fujifilm.</p><Link class="button" href="/photos">Browse photographs</Link></div>
    </div>
  </section>
  <section class="band wrap homepage-contact" id="contact">
    <div><h2>Contact</h2><p>Have a project in mind, a role to discuss, or a question about a photograph?</p></div>
    <div class="actions"><Link class="button" href="/contact">Write a message</Link><Link href="https://www.linkedin.com/in/joydip-majumdar/">Connect on LinkedIn</Link></div>
  </section>
</Base>
