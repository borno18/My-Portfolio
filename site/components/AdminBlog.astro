---
import AdminIcon from './AdminIcon.astro';
import AdminBlogResults from './AdminBlogResults.astro';
import AdminPostEditor from './AdminPostEditor.astro';
const { items, post, originalSlug, preview, editing, search, filter, postCount, postStatus, blogUrl, page, hasNext } = Astro.props;
const states = { published: 'Published', draft: 'Drafts', scheduled: 'Scheduled', archived: 'Archived' };
const currentEdit = post ? originalSlug || '_new' : editing;
---
<div class="admin-blog-split">
  <section class="admin-pane blog-index" id="blog-index" aria-labelledby="blog-admin-title">
    <div class="admin-section-head">
      <h2 id="blog-admin-title" tabindex="-1">Blog posts <span class="badge admin-count" data-article-count>{postCount}</span></h2>
      <a class="btn btn-primary button" href={blogUrl('_new') + '#editor-heading'}><AdminIcon name="plus" />New article</a>
    </div>
    <form method="get" action="/admin" class="blog-search">
      <input type="hidden" name="section" value="blog" />
      {currentEdit && <input type="hidden" name="edit" value={currentEdit} />}
      <label class="admin-search"><AdminIcon name="search" /><input name="q" aria-label="Search articles" placeholder="Search articles…" type="search" maxlength="100" value={search} /></label>
      <select name="status" aria-label="Article status">
        <option value="">All statuses</option>
        {Object.entries(states).map(([status, label]) => <option value={status} selected={filter === status}>{label}</option>)}
      </select>
      <noscript><button class="button secondary">Apply filters</button></noscript>
    </form>
    <p class="blog-list-feedback" aria-live="polite" data-article-feedback></p>
    <AdminBlogResults {items} originalSlug={currentEdit} {postCount} {postStatus} {blogUrl} {page} {hasNext} />
  </section>
  {post ? <AdminPostEditor {post} {originalSlug} {preview} status={postStatus(post)} actionUrl={blogUrl(originalSlug || '_new')} /> :
    <section class="admin-pane admin-editor-empty"><h2>{editing ? 'Article unavailable' : 'No article selected'}</h2><p class="admin-muted">{editing ? 'Choose an article from the list.' : 'Create an article to start writing.'}</p></section>}
</div>
<script>
  const layout = document.querySelector<HTMLElement>('.admin-blog-split');
  const listing = layout?.querySelector<HTMLElement>('#blog-index');
  const form = listing?.querySelector<HTMLFormElement>('.blog-search');
  const focus = layout?.querySelector<HTMLButtonElement>('[data-toggle-list]');
  if (focus && listing) {
    focus.hidden = false;
    focus.addEventListener('click', () => {
      listing.hidden = !listing.hidden;
      focus.setAttribute('aria-expanded', String(!listing.hidden));
      focus.title = focus.ariaLabel = listing.hidden ? 'Show article list' : 'Hide article list';
    });
  }
  if (listing && form) {
    const search = form.elements.namedItem('q') as HTMLInputElement;
    const filter = form.elements.namedItem('status') as HTMLSelectElement;
    const feedback = listing.querySelector<HTMLElement>('[data-article-feedback]')!;
    const count = listing.querySelector<HTMLElement>('[data-article-count]')!;
    let pending: AbortController | undefined;
    let timer: ReturnType<typeof setTimeout>;
    const refresh = async (page?: string) => {
      const controller = new AbortController();
      pending = controller;
      const url = new URL(form.action);
      for (const [name, value] of new FormData(form)) url.searchParams.set(name, String(value));
      if (page) url.searchParams.set('page', page);
      url.searchParams.set('view', 'article-list');
      try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) throw new Error();
        const document = new DOMParser().parseFromString(await response.text(), 'text/html');
        const results = document.querySelector<HTMLElement>('[data-article-results]');
        if (controller.signal.aborted) return;
        if (!results) throw new Error();
        listing.querySelector('[data-article-results]')?.replaceWith(results);
        count.textContent = results.dataset.count || '0';
        feedback.textContent = count.textContent === '1' ? '1 matching article' : count.textContent + ' matching articles';
        feedback.classList.remove('is-error');
        if (page) results.querySelector<HTMLElement>('[data-page-number]')?.focus();
      } catch {
        if (controller.signal.aborted) return;
        feedback.textContent = 'Could not refresh articles. Try searching again.';
        feedback.classList.add('is-error');
      }
    };
    const cancel = () => { clearTimeout(timer); pending?.abort(); };
    search.addEventListener('input', () => {
      cancel();
      timer = setTimeout(() => void refresh(), 250);
    });
    const apply = () => { cancel(); void refresh(); };
    filter.addEventListener('change', apply);
    form.addEventListener('submit', event => { event.preventDefault(); apply(); });
    listing.addEventListener('click', event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('[data-article-page]');
      if (!link || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      cancel();
      void refresh(new URL(link.href).searchParams.get('page') || '1');
    });
  }
</script>
