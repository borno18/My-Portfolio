---
import AdminIcon from './AdminIcon.astro';
import AdminPostEditor from './AdminPostEditor.astro';
const { items, post, originalSlug, preview, editing, search, filter, postCounts, postStatus, blogUrl, page, hasNext } = Astro.props;
const states = { published: 'Published', draft: 'Drafts', scheduled: 'Scheduled', archived: 'Archived' };
const total = Object.values(postCounts).reduce((sum, count) => sum + count, 0);
const date = value => new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'Asia/Dhaka' }).format(new Date(value));
---
<div class="admin-blog-split">
  <section class="admin-pane blog-index" aria-labelledby="blog-admin-title">
    <div class="admin-section-head">
      <h2 id="blog-admin-title">Blog posts <span class="badge admin-count">{total}</span></h2>
      <a class="btn btn-primary button admin-sage-action" href={blogUrl('_new') + '#editor-heading'}><AdminIcon name="plus" />New article</a>
    </div>
    <form method="get" class="blog-search">
      <input type="hidden" name="section" value="blog" />
      {filter && <input type="hidden" name="status" value={filter} />}
      <label class="admin-search"><AdminIcon name="search" /><input name="q" aria-label="Search articles" placeholder="Search articles…" type="search" maxlength="100" value={search} /></label>
      <button class="btn btn-outline button secondary">Search</button>
    </form>
    <nav class="admin-chips" aria-label="Article status">
      {Object.entries({ '': 'All', ...states }).map(([status, label]) => (
        <a href={blogUrl(null, { status, page: 1 })} aria-current={filter === status ? 'true' : undefined}>{label} ({status ? postCounts[status] : total})</a>
      ))}
    </nav>
    {items.length ? <ul class="blog-rows">
      {items.map(item => {
        const status = postStatus(item);
        const timestamp = status === 'scheduled' ? item.published_at : item.updated_at || item.published_at;
        return <li><a href={blogUrl(item.slug) + '#editor-heading'} aria-current={originalSlug === item.slug ? 'true' : undefined}>
          {item.cover_path ? <img src={'/blog-cover/' + item.cover_path} alt="" width="76" height="54" loading="lazy" /> :
            <span class="blog-row-placeholder"><AdminIcon name="blog" /></span>}
          <span class="blog-row-copy"><strong>{item.title}</strong><span class="blog-row-meta">
            <span class:list={['admin-status', 'status-' + status]}>{status === 'draft' ? 'Draft' : states[status]}</span>
            {timestamp && <time datetime={timestamp}>{date(timestamp)}</time>}
          </span></span>
        </a></li>;
      })}
    </ul> : <p class="admin-empty">No articles match this view.</p>}
    {(page > 1 || hasNext) && <nav class="admin-pagination" aria-label="Article pages">
      {page > 1 && <a class="button secondary" href={blogUrl(null, { page: page - 1 })}>Previous</a>}
      <span>Page {page}</span>
      {hasNext && <a class="button secondary" href={blogUrl(null, { page: page + 1 })}>Next</a>}
    </nav>}
  </section>
  {post ? <AdminPostEditor {post} {originalSlug} {preview} status={postStatus(post)} actionUrl={blogUrl(originalSlug || '_new')} backUrl={blogUrl(null) + '#blog-admin-title'} /> :
    <section class="admin-pane admin-editor-empty"><h2>{editing ? 'Article unavailable' : 'No article selected'}</h2><p class="admin-muted">{editing ? 'Choose an article from the list.' : 'Create an article to start writing.'}</p></section>}
</div>
