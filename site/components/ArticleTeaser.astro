---
import Link from './Link.astro';
import EditorialMedia from './EditorialMedia.astro';
import { editorialDetails } from '../lib/editorial.js';
const { post, heading = "h3" } = Astro.props;
const Heading = heading;
const detail = editorialDetails(post);
---
<article class="newspaper-story">
  <div class="story-image">
    <EditorialMedia cover={detail.cover} />
  </div>
  <p class="story-meta">{detail.category}<span aria-hidden="true">·</span>{detail.minutes}</p>
  <Heading><Link href={'/blog/' + post.slug}>{post.title}</Link></Heading>
  <p class="story-deck">{post.description}</p>
  {detail.date && <time class="story-date" datetime={post.published_at}>{detail.date}</time>}
</article>
