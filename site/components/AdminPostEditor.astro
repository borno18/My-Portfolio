---
const { post, originalSlug, preview, editing } = Astro.props;
---
<section class="admin-editor" aria-labelledby="editor-heading">
  <div class="admin-heading"><h2 id="editor-heading">{editing === '_new' ? 'New article' : 'Edit article'}</h2>
    <a href="/admin?section=blog">Back to posts</a>
  </div>
  <form method="post" enctype="multipart/form-data">
    <input type="hidden" name="original_slug" value={originalSlug} />
    <label>Title<input name="title" required maxlength="160" value={post.title} /></label>
    <label>URL slug<input name="slug" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" value={post.slug} readonly={Boolean(originalSlug)} /></label>
    <label>Description<input name="description" required maxlength="300" value={post.description} /></label>
    <fieldset class="article-cover-fields">
      <legend>Cover image</legend>
      {post.cover_path && <img src={'/blog-cover/' + post.cover_path} alt={post.cover_alt} width="240" />}
      <label>{post.cover_path ? 'Replace cover' : 'Upload cover'}
        <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" aria-describedby="cover-format" />
      </label>
      <p id="cover-format">JPG, PNG, or WebP under 3.5 MB.</p>
      <label>Cover alt text<input name="cover_alt" maxlength="250" value={post.cover_alt} /></label>
      {post.cover_path && <label><span><input type="checkbox" name="remove_cover" value="yes" /> Remove current cover</span></label>}
    </fieldset>
    <label>Article in Markdown<textarea name="body" required maxlength="65000" rows="14">{post.body}</textarea></label>
    <div class="actions">
      {post.status !== 'published' && <button class="button secondary" name="action" value="save-draft">Save draft</button>}
      <button class="button secondary" name="action" value="preview-post" formnovalidate>Preview Markdown</button>
      <button class="button" name="action" value="publish-post">{post.status === 'published' ? 'Update published article' : 'Publish article'}</button>
    </div>
  </form>
  {originalSlug && <>
    {post.status === 'published' && <form method="post">
      <input type="hidden" name="slug" value={originalSlug} />
      <button class="button secondary" name="action" value="unpublish-post">Unpublish to draft</button>
    </form>}
    <details>
      <summary>Delete article</summary>
      <form method="post">
        <input type="hidden" name="slug" value={originalSlug} />
        <label><span><input type="checkbox" name="confirm" value="yes" required /> Permanently delete this article</span></label>
        <button class="button secondary" name="action" value="delete-post">Delete permanently</button>
      </form>
    </details>
  </>}
  {preview && <div class="admin-preview"><h3>Markdown preview</h3><div class="article article-prose" set:html={preview} /></div>}
</section>
<style>
  .article-cover-fields { min-width: 0; margin: 0; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: 6px; }
  .article-cover-fields legend { padding-inline: .35rem; font-weight: 600; }
  .article-cover-fields img { margin-bottom: .75rem; border-radius: 4px; }
  #cover-format { color: var(--muted); font-size: .85rem; margin: .25rem 0 .65rem; }
  .article-cover-fields label + label { margin-top: .75rem; }
</style>
