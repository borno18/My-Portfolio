---
import { Image } from 'astro:assets';
import sports from '../assets/sports.png';
import pookieHome from '../assets/pookie-home.png';
import pookieQuiz from '../assets/pookie-quiz.png';
import attendanceIcon from '../assets/attendance-icon.png';
const { project, large = false } = Astro.props;
---
{project.slug === 'swe-sports-week' ? (
  <Image src={sports} alt="SWE Sports Week homepage showing the list of sports" width={large ? 1200 : 800}
    widths={large ? [480, 800, 1200] : [360, 560, 800]}
    sizes={large ? '(max-width: 680px) 92vw, (max-width: 1200px) 92vw, 1170px' : '(max-width: 680px) 92vw, (max-width: 1200px) 46vw, 585px'}
    format="webp" loading={large ? 'eager' : 'lazy'} />
) : project.slug === 'attendance-app' ? (
  <div class="attendance-media" role="img" aria-label="Attendance workflow diagram. Import a class roster, start a nearby session, then export attendance.">
    <div class="attendance-mark"><Image src={attendanceIcon} alt="" width={64} height={64} /><span>Smart Proximity<br />Attendance</span></div>
    <div class="attendance-steps" aria-hidden="true"><span>Class roster</span><span>Nearby session</span><span>Attendance export</span></div>
  </div>
) : project.slug === 'pookie-prep' ? (
  <div class="project-art phone-art">
    <Image src={pookieHome} alt="Pookie Prep’s Bengali home screen" width={340} format="webp" />
    <Image src={pookieQuiz} alt="Pookie Prep’s Bengali multiple choice practice screen" width={340} format="webp" />
  </div>
) : (
  <div class="project-art queue-media" role="img" aria-label="QueueStorm workflow. Check a support ticket against evidence and return a structured verdict.">
    <span>Support ticket</span><span>Evidence matching</span><span>Structured verdict</span>
  </div>
)}
