---
const { id } = Astro.props;
---
<dialog aria-labelledby={id} data-media-dialog>
  <div class="lightbox-toolbar">
    <div class="actions">
      <button type="button" class="button secondary" data-prev>Previous</button>
      <button type="button" class="button secondary" data-next>Next</button>
    </div>
    <div class="actions">
      <button type="button" class="button secondary zoom-button" data-zoom aria-label="Image zoom" aria-pressed="false" title="Zoom in">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4 4M7.5 10.5h6" />
          <path class="zoom-plus" d="M10.5 7.5v6" />
        </svg>
      </button>
      <form method="dialog"><button class="button" autofocus>Close</button></form>
    </div>
  </div>
  <div data-stage class="lightbox-stage" tabindex="0" role="region" aria-label="Image preview">
    <img alt="" hidden data-image />
    <p data-error hidden>Couldn’t load the preview. <a data-original target="_blank" rel="noopener noreferrer">Open image</a></p>
  </div>
  <div class="lightbox-caption" aria-live="polite">
    <strong id={id} data-title></strong>
    <span data-caption></span>
  </div>
</dialog>

<style>
  .lightbox-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .75rem; }
  .lightbox-toolbar .actions { gap: .5rem; margin: 0; }
  .lightbox-toolbar form { margin: 0; }
  .lightbox-toolbar .button { padding-inline: .75rem; }
  .lightbox-toolbar .zoom-button { width: 44px; padding-inline: 0; }
  .zoom-button[aria-pressed="true"] .zoom-plus { display: none; }
  .lightbox-stage { overflow: auto; max-height: min(63dvh, 650px); background: #130d0a; overscroll-behavior: contain; }
  .lightbox-stage img { width: 100%; height: min(63dvh, 650px); object-fit: contain; }
  .lightbox-stage[data-zoomed] img { width: 200%; max-width: none; height: auto; }
  .lightbox-stage p { color: #f1e9dc; padding: .75rem; }
  .lightbox-stage p a { color: inherit; }
  .lightbox-caption { padding-top: .75rem; }
  .lightbox-caption span { display: block; color: var(--muted); }
  .lightbox-caption span:empty { display: none; }
</style>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-media-dialog]')) {
    const gallery = dialog.closest('[data-media-gallery]');
    const stage = dialog.querySelector<HTMLElement>('[data-stage]');
    const image = dialog.querySelector<HTMLImageElement>('[data-image]');
    const title = dialog.querySelector<HTMLElement>('[data-title]');
    const caption = dialog.querySelector<HTMLElement>('[data-caption]');
    const zoom = dialog.querySelector<HTMLButtonElement>('[data-zoom]');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-next]');
    const error = dialog.querySelector<HTMLElement>('[data-error]');
    const original = dialog.querySelector<HTMLAnchorElement>('[data-original]');
    if (!dialog.showModal || !gallery || !stage || !image || !title || !caption ||
        !zoom || !prev || !next || !error || !original) continue;

    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-media-image]')];
    const available = () => links.filter(link => !link.closest('[hidden]'));
    let active = 0;
    let trigger: HTMLAnchorElement;

    const setZoom = (enabled: boolean) => {
      stage.toggleAttribute('data-zoomed', enabled);
      zoom.setAttribute('aria-pressed', String(enabled));
      zoom.title = enabled ? 'Zoom out' : 'Zoom in';
      stage.scrollTo(enabled ? (stage.scrollWidth - stage.clientWidth) / 2 : 0,
        enabled ? (stage.scrollHeight - stage.clientHeight) / 2 : 0);
    };

    const show = (position: number) => {
      const visible = available();
      active = (position + visible.length) % visible.length;
      const item = visible[active];
      if (!item) return;
      setZoom(false);
      prev.hidden = next.hidden = visible.length < 2;
      error.hidden = true;
      image.hidden = false;
      zoom.disabled = true;
      image.alt = item.dataset.alt || item.dataset.title || '';
      title.textContent = item.dataset.title || '';
      caption.textContent = item.dataset.caption || '';
      original.href = image.src = item.href;
    };

    image.addEventListener('load', () => { zoom.disabled = false; });
    image.addEventListener('error', () => {
      image.hidden = true;
      error.hidden = false;
    });
    zoom.addEventListener('click', () => setZoom(!stage.hasAttribute('data-zoomed')));
    prev.addEventListener('click', () => show(active - 1));
    next.addEventListener('click', () => show(active + 1));
    for (const link of links) link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      trigger = link;
      show(available().indexOf(link));
      dialog.showModal();
    });
    dialog.addEventListener('keydown', event => {
      if (stage.hasAttribute('data-zoomed') || available().length < 2) return;
      if (event.key === 'ArrowLeft') show(active - 1);
      if (event.key === 'ArrowRight') show(active + 1);
    });
    dialog.addEventListener('close', () => trigger?.focus());
  }
</script>
